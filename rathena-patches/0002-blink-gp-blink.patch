+// Copyright (c) rAthena Dev Teams - Licensed under GNU GPL
+// For more information, see LICENCE in the main folder
+
+#include "blink.hpp"
+
+#include "map/clif.hpp"
+#include "map/unit.hpp"
+
+// GP_BLINK (id 9000) — Blink 15: teleporta o personagem PRA FRENTE, na
+// direção em que está virado, até `Knockback` (skill_db.yml) células.
+//
+// Reaproveita exatamente a mesma cadeia do Backslide (TF_BACKSLIDING,
+// skills/thief/backslide.cpp): skill_blown() -> unit_blown() ->
+// path_blownpos(). É o path_blownpos (map/path.cpp) que anda célula a
+// célula com map_getcellp(..., CELL_CHKPASS) e para na ÚLTIMA célula válida
+// antes do primeiro bloqueio (parede/penhasco/água bloqueada/fora do mapa) —
+// a mesma checagem de colisão usada pelo movimento normal, nenhuma lógica
+// paralela.
+//
+// A ÚNICA diferença para o Backslide é a direção: skill_blown() SEMPRE
+// inverte o vetor recebido (dx = -dirx[dir], dy = -diry[dir] — é assim que
+// o Backslide, alimentado com unit_getdir(bl), sai pra trás). Alimentando a
+// direção OPOSTA à que o personagem encara, essa inversão interna devolve o
+// vetor pra frente, sem duplicar path_blownpos nem escrever um unit_blown()
+// paralelo.
+SkillBlink::SkillBlink() : SkillImpl(GP_BLINK) {
+}
+
+void SkillBlink::castendNoDamageId(block_list *src, block_list *bl, uint16 skill_lv, t_tick tick, int32 &flag) const {
+	uint8 dir_oposta = (unit_getdir(bl) + 4) % 8; // ver comentário acima: skill_blown() inverte de novo
+
+	int16 blew_count = skill_blown(src, bl, skill_get_blewcount(getSkillId(), skill_lv), dir_oposta,
+	                               static_cast<enum e_skill_blown>(BLOWN_IGNORE_NO_KNOCKBACK | BLOWN_DONT_SEND_PACKET));
+	clif_skill_nodamage(src, *bl, getSkillId(), skill_lv);
+
+	if (blew_count > 0)
+		clif_blown(src); // Always blow, otherwise it shows a casting animation. [Lemongrass]
+}
